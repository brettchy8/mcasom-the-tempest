---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import {
  works,
  authorFor,
  issueUrl,
  readerUrl,
  url,
  prose,
  initials,
  isPoetry,
} from '../../lib/content';
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const author = authorFor(work);
---

<Site title={work.title} description={work.excerpt}
  ><main id="main" class="work-page site-main">
    <a class="breadcrumb" href={issueUrl(work.issue)}>← The {work.issue} issue</a>
    <header class="work-header">
      <div class="eyebrow accent">{work.category} <i>·</i> {work.issue}</div><h1>{work.title}</h1><p
        class="work-author"
      >
        by <a href={url(`/authors/${author.slug}/`)}>{author.name}</a>
      </p>
    </header>
    <div class="work-reading-layout">
      <div class="work-body">
        {
          work.recordings.length > 0 && (
            <section class="audio-section" id="listen" aria-label="Audio recordings">
              {work.recordings.map((recording) => (
                <div class="audio-card">
                  <div class="audio-card-title">
                    <Icon name="headphones" />
                    <h2>{recording.title}</h2>
                  </div>
                  {recording.description && <p>{recording.description}</p>}
                  <audio controls preload="none" aria-label={recording.title}>
                    <source src={url(recording.file)} type="audio/mpeg" />
                    <a href={url(recording.file)}>Download recording</a>
                  </audio>
                  <a class="audio-download" href={url(recording.file)} download>
                    Download MP3
                  </a>
                </div>
              ))}
            </section>
          )
        }
        {
          work.body &&
            (isPoetry(work.category) ? (
              <div class="poem">{work.body}</div>
            ) : (
              <div class="prose" set:html={prose(work.body)} />
            ))
        }
        {
          work.artworks.map((art) => (
            <figure class="work-art">
              <>
                <img src={url(art.image)} alt={art.alt} loading="lazy" />
                <figcaption>{art.caption}</figcaption>
              </>
            </figure>
          ))
        }
      </div>
      <aside class="work-margin" aria-label="About this work and its author">
        {
          work.about && (
            <section class="work-note" aria-labelledby="work-note-title">
              <h2 class="eyebrow" id="work-note-title">
                About the work
              </h2>
              <div class="prose" set:html={prose(work.about)} />
            </section>
          )
        }
        <section class="work-author-note" aria-labelledby="work-author-title">
          <h2 class="eyebrow" id="work-author-title">About the author</h2>
          <a class="author-teaser" href={url(`/authors/${author.slug}/`)}>
            {
              author.portrait ? (
                <img src={url(author.portrait)} alt="" loading="lazy" />
              ) : (
                <span class="avatar-letter" aria-hidden="true">
                  {initials(author.name)}
                </span>
              )
            }
            <div>
              <h3>{author.name}</h3>
              <span class="text-link">Meet the author <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        </section>
        {
          work.pdfPage && (
            <a class="text-link work-pdf-link" href={readerUrl(work.issue, work.pdfPage)}>
              Read in issue <Icon name="arrow" size={15} />
            </a>
          )
        }
      </aside>
    </div>
  </main></Site
>
